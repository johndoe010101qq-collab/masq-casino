# Separate Node host with persistent storage; this is not a Pages upload.
# Configure TLS, DNS and MASQ_APP_ORIGIN for this exact hostname before use.
server {
  listen 443 ssl;
  server_name casino.example;
  ssl_certificate /etc/letsencrypt/live/casino.example/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/casino.example/privkey.pem;
  root /srv/masq/dist;
  include /etc/nginx/mime.types;
  add_header Content-Security-Policy "frame-ancestors 'self' https://spworlds.ru" always;
  add_header X-Content-Type-Options nosniff always;

  # No X-Frame-Options: SPWorlds must be able to embed the application.
  location ^~ /api/ {
    client_max_body_size 16k;
    proxy_pass http://127.0.0.1:5187;
    proxy_set_header Host $host;
    proxy_set_header Origin $http_origin;
    proxy_set_header Authorization $http_authorization;
    proxy_connect_timeout 5s;
    proxy_read_timeout 20s;
    proxy_cache off;
  }
  location ~ (^|/)\. { deny all; }
  location / { try_files $uri $uri/ /index.html; }
}
