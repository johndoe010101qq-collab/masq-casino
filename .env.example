# Public mini-app ID from the SP Worlds app page.
VITE_SPW_APP_ID=e72e9ddb-1792-4481-ad85-f24e64b24611
# Optional: enable only after deploying the matching backend endpoint.
VITE_SPW_VALIDATE_URL=
# Example when configured: /api/spw/validate

# Server only. Never use a VITE_ prefix for this token.
SPW_APP_TOKEN=

# Enable the server-backed admin client only with the matching server available.
VITE_MASQ_SERVER_ADMIN=0
# Exact SPWorlds account IDs; never nicknames or provider roles.
MASQ_OWNER_ACCOUNT_IDS=
# Set only after confirming the platform's timestamp unit (seconds/milliseconds).
SPW_TIMESTAMP_UNIT=
# Local development: Vite and API must share this browser origin via the proxy.
MASQ_APP_ORIGIN=http://127.0.0.1:5178
MASQ_ADMIN_PORT=5187
MASQ_ADMIN_DB=server/data/masq-admin.sqlite


